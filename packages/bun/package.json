{
  "name": "@siftlite/bun",
  "version": "0.0.0",
  "description": "SiftLite bun:sqlite runtime adapter.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@siftlite/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/siftlite.git",
    "directory": "packages/bun"
  },
  "bugs": {
    "url": "https://github.com/aashahin/siftlite/issues"
  },
  "homepage": "https://github.com/aashahin/siftlite#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "siftlite",
    "bun",
    "sqlite",
    "adapter"
  ]
}
