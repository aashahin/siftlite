{
  "name": "@siftlite/cli",
  "version": "0.2.0",
  "description": "SiftLite CLI for check, doctor, generate, and safe lifecycle operations.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "siftlite": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepack": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@siftlite/core": "^0.2.0",
    "@siftlite/fts5": "^0.2.0"
  },
  "devDependencies": {
    "@siftlite/bun": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/siftlite.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/aashahin/siftlite/issues"
  },
  "homepage": "https://github.com/aashahin/siftlite#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "siftlite",
    "cli",
    "search"
  ]
}
