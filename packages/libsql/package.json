{
  "name": "@siftlite/libsql",
  "version": "0.2.0",
  "description": "SiftLite libSQL/Turso Cloud FTS5 runtime adapter.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@siftlite/core": "^0.2.0"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@siftlite/testing": "^0.2.0"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/siftlite.git",
    "directory": "packages/libsql"
  },
  "bugs": {
    "url": "https://github.com/aashahin/siftlite/issues"
  },
  "homepage": "https://github.com/aashahin/siftlite#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "siftlite",
    "libsql",
    "turso",
    "sqlite",
    "adapter"
  ]
}
