{
  "name": "@siftlite/drizzle",
  "version": "0.1.0",
  "description": "SiftLite Drizzle companion: metadata mapping, typed indexes, and hydration.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@siftlite/core": "^0.1.0",
    "@siftlite/fts5": "^0.1.0"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@siftlite/bun": "^0.1.0",
    "@siftlite/libsql": "^0.1.0",
    "drizzle-orm": "0.45.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/siftlite.git",
    "directory": "packages/drizzle"
  },
  "bugs": {
    "url": "https://github.com/aashahin/siftlite/issues"
  },
  "homepage": "https://github.com/aashahin/siftlite#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "siftlite",
    "drizzle",
    "sqlite",
    "search"
  ]
}
